{
  "schemaVersion": "0.1.0",
  "name": "AutoPet Sample Pet",
  "version": "0.1.0",
  "sprite": "spritesheet.png",
  "frameWidth": 256,
  "frameHeight": 256,
  "defaultState": "idle",
  "states": {
    "idle": {
      "row": 0,
      "frames": 8,
      "fps": 8,
      "loop": true
    },
    "bounce": {
      "row": 1,
      "frames": 8,
      "fps": 8,
      "loop": true
    },
    "click": {
      "row": 2,
      "frames": 6,
      "fps": 12,
      "loop": false,
      "next": "idle"
    },
    "sleep": {
      "row": 3,
      "frames": 8,
      "fps": 6,
      "loop": true
    },
    "drag": {
      "row": 4,
      "frames": 1,
      "fps": 1,
      "loop": true
    }
  },
  "hitbox": {
    "x": 32,
    "y": 32,
    "width": 192,
    "height": 192
  }
}
